SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins for CORS (TanStack dev + production)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,https://the-royal-passage.vercel.app

# Security (Sprint 6)
RATE_LIMIT_PER_MINUTE=120
ENABLE_API_DOCS=false

# Resend (transactional emails from the API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreplay@theroyalpassage.com
RESEND_FROM_NAME=The Royal Passage
SITE_URL=https://the-royal-passage.vercel.app

# Secret for Render cron → POST /internal/cron/host-booking-reminders
CRON_SECRET=
