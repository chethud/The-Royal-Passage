# Copy to ".env" (never commit). Keys: Dashboard → Project Settings → API
# Also sync to .env.local (Vite) and backend/.env (FastAPI) for local dev.
#
# Project URL (same value for VITE_ and server)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe key (legacy JWT "anon" key or new "publishable" key from the dashboard)
# Next.js projects use NEXT_PUBLIC_SUPABASE_* — this app uses VITE_SUPABASE_* instead.
VITE_SUPABASE_ANON_KEY=

# FastAPI backend (required on Vercel for admin/bookings)
# Local dev:
VITE_API_BASE_URL=http://localhost:8000
# Vercel production (set in Vercel dashboard → Environment Variables):
# VITE_API_BASE_URL=https://the-royal-passage.onrender.com

# Canonical site URL for SEO (sitemap, OpenGraph, JSON-LD)
SITE_URL=https://the-royal-passage.vercel.app

# Server-only — never use VITE_ prefix. Full access; keep off the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias for server builds that don't inject VITE_
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Google OAuth (for Supabase Auth provider)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Redis cache (Upstash REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
