# Copy to ".env" (never commit). Keys: Dashboard → Project Settings → API
# Also sync to .env.local (Vite) and backend/.env (FastAPI) for local dev.
#
# Project URL (same value for VITE_ and server)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe key (legacy JWT "anon" key or new "publishable" key from the dashboard)
# Next.js projects use NEXT_PUBLIC_SUPABASE_* — this app uses VITE_SUPABASE_* instead.
VITE_SUPABASE_ANON_KEY=

# FastAPI backend (required on Vercel for admin/bookings)
# Local dev:
VITE_API_BASE_URL=http://localhost:8000
# Vercel production (set in Vercel dashboard → Environment Variables):
# VITE_API_BASE_URL=https://the-royal-passage.onrender.com

# Canonical site URL for SEO (sitemap, OpenGraph, JSON-LD)
SITE_URL=https://the-royal-passage.vercel.app

# Public site origin for auth email links (optional; defaults to window.location on client)
# Set on Vercel so confirmation emails never point at localhost.
VITE_SITE_URL=https://the-royal-passage.vercel.app
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://the-royal-passage.vercel.app   (NOT localhost — fixes OAuth redirect)
#   Redirect URLs (add all):
#     https://the-royal-passage.vercel.app/**
#     https://the-royal-passage.vercel.app/auth/callback
#     http://localhost:5173/**
#     http://localhost:5173/auth/callback

# Server-only — never use VITE_ prefix. Full access; keep off the client.
# REQUIRED on Vercel for editor homepage photo upload + save to go live for all users.
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias for server builds that don't inject VITE_
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Google sign-in — configure in Supabase, not in this app:
#   1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
#   2. Authorized redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#   3. Supabase → Authentication → Providers → Google → paste Client ID + Client Secret
#   4. Enable the Google provider and Save

# Optional Redis cache (Upstash REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
