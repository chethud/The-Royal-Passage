# Copy to ".env.local" (never commit). Keys: Dashboard → Project Settings → API
#
# Project URL (same value for VITE_ and server)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe anon key (JWT "anon" or new "publishable" key from the dashboard)
VITE_SUPABASE_ANON_KEY=

# Server-only — never use VITE_ prefix. Full access; keep off the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias for server builds that don't inject VITE_
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Google OAuth (for Supabase Auth provider)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Redis cache (Upstash REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
